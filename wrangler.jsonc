{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huiaiclass",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  // 4단계 AI 분석용 Workers AI 연결은 Cloudflare 빌드 실패 원인을 확인할 때까지 잠시 꺼 둠.
  // 다시 켜려면 아래 주석을 풀면 됩니다:  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "classroom-db",
      "database_id": "e5715529-a0c4-4f80-869b-77fac56fbcfd"
    }
  ]
}
